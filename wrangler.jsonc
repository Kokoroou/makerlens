// One Worker serves the whole MakerLens family as static files:
//   /         landing page (site/)
//   /assets/  MakerLens Assets  (Kokoroou/rpgmaker-assets-viewer)
//   /events/  MakerLens Events  (Kokoroou/rpgmaker-events-viewer)
// `npm run build` assembles them into _site/. Files are served as static assets
// through the ASSETS binding; src/worker.js runs first on every request so the old
// makerlens.kokoroou.workers.dev URLs 301 to https://makerlens.kokoroou.com/ (a
// workers.dev host has no zone, so no Redirect Rule can do it), then serves directory
// index pages and the 404 page. The custom domain is attached in the Cloudflare
// dashboard (Workers → makerlens → Domains); workers_dev stays on for the redirect.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "makerlens",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
